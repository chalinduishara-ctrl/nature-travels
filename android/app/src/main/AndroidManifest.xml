<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ============================================================= -->
    <!-- 🌐 1. INTERNET & NETWORK PERMISSIONS                         -->
    <!-- (Map tiles load වීමට, OpenStreetMap/Esri සහ Firebase සදහා)       -->
    <!-- ============================================================= -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>

    <!-- ============================================================= -->
    <!-- 📍 2. PRECISE HARDWARE GPS & LOCATION PERMISSIONS             -->
    <!-- (Wilderness Trails වල accurate live navigation සහ speed එකට) -->
    <!-- ============================================================= -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    
    <!-- Phone එක pocket එකේ හෝ screen off කර hike කරද්දී track වීමට -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>

    <!-- ============================================================= -->
    <!-- 🔔 3. NOTIFICATIONS & FOREGROUND SERVICES (Android 13 & 14+)  -->
    <!-- (Live trail tracking notification සහ Hazard alerts පෙන්වීමට)  -->
    <!-- ============================================================= -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    
    <!-- Foreground Service permissions (Hike record වෙද්දී background kill නොවීමට) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>

    <!-- ============================================================= -->
    <!-- ⚡ 4. HARDWARE SENSORS, WAKE LOCK & VIBRATION                 -->
    <!-- (SOS siren, Hazard warning vibration & screen timeout control) -->
    <!-- ============================================================= -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.VIBRATE"/>

    <!-- GPS Hardware එක ඇති devices වල high accuracy enable කිරීමට -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false"/>
    <uses-feature android:name="android.hardware.location.network" android:required="false"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <!-- ============================================================= -->
    <!-- 📷 5. CAMERA & STORAGE PERMISSIONS                            -->
    <!-- (Profile photo, Expedition logs & Hazard alert photos සඳහා)  -->
    <!-- ============================================================= -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- Android 12 සහ ඊට පහළ සඳහා -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28"/>
    <!-- Android 13+ (API 33+) සඳහා modern photo picker permission -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>

    <!-- ============================================================= -->
    <!-- 📞 6. SOS EMERGENCY CALLS & DIALER                            -->
    <!-- (1990 Ambulance, 119 Police, 1992 Wildlife rescue call කිරීමට) -->
    <!-- ============================================================= -->
    <uses-permission android:name="android.permission.CALL_PHONE"/>

    <application
        android:label="Nature Travels"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
              
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Flutter tool generated metadata -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
            
        <!-- Android 14 Location Foreground Service configuration -->
        <service
            android:name="com.baseflow.geolocator.GeolocatorLocationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>

    <!-- ============================================================= -->
    <!-- 🔍 7. PACKAGE VISIBILITY QUERIES (Android 11+ / API 30+)       -->
    <!-- (SOS Dialing, SMS, External Maps සහ Browser links open වීමට)   -->
    <!-- ============================================================= -->
    <queries>
        <!-- SOS dialer (1990, 119, 1992 ආදිය open කිරීමට) -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <!-- SMS යැවීමට -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <!-- Google Maps / External Maps links සඳහා -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <!-- Web links (Wikipedia / Guidelines open කිරීමට) -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>

</manifest>